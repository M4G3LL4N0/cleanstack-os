{
  "name": "cleanstack-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "killall -9 node || true && rm -rf .next node_modules",
    "build:clean": "pnpm run clean && pnpm install && pnpm run build",
    "build:safe": "pnpm run clean && pnpm install && next build",
    "kill-node": "killall -9 node || true"
  },
  "turbopack": {
    "root": "."
  },
  "dependencies": {
    "next": "^16.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@supabase/supabase-js": "^2.84.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.3.0"
}
